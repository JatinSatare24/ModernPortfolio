# Copy this file to ".env.local" for local testing, and add the same
# variables in Netlify (Site configuration -> Environment variables).

# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered (your own inbox)
CONTACT_TO_EMAIL=jatinsatare@gmail.com

# The "from" address. Until you verify your own domain in Resend, use:
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
